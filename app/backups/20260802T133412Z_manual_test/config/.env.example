# TitanAI Environment Configuration
# Copy to .env and adjust values for your environment

# Application
APP_NAME=TitanAI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Security (change in production)
SECRET_KEY=change-me-to-a-secure-random-string

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL (placeholder)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=titanai
POSTGRES_PASSWORD=titanai
POSTGRES_DB=titanai
DATABASE_URL=postgresql+asyncpg://titanai:titanai@localhost:5432/titanai

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI / Trading (placeholders — configure when implementing)
# OPENAI_API_KEY=
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
